{
  "name": "desktop-pet-v2",
  "version": "0.1.1",
  "packageManager": "npm@10.9.9",
  "private": true,
  "description": "Independent cross-platform desktop pet and reminder assistant compatible with Codex pet packages.",
  "author": "husu",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "npm run build:main && concurrently -k -n renderer,electron \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host localhost --port 3000",
    "dev:electron": "wait-on http://localhost:3000/pet/index.html && cross-env DESKTOP_PET_DEV_SERVER_URL=http://localhost:3000 electron .",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "verify:data": "node scripts/verify-runtime-data.mjs",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "assets:store:screenshots": "node scripts/generate-store-screenshots.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "npm run lint && npm run typecheck && npm run verify:data && npm run test && npm run build",
    "pack:dir": "npm run check && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --config electron-builder.yml",
    "pack:mac": "npm run check && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config electron-builder.yml",
    "pack:win": "npm run check && electron-builder --win --config electron-builder.yml",
    "pack:store": "npm run check && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win appx --x64 --config electron-builder.yml --publish never",
    "pack:linux": "npm run check && electron-builder --linux --config electron-builder.yml",
    "release:verify": "node scripts/release.mjs verify",
    "sbom": "npm sbom --omit=dev --sbom-format=spdx"
  },
  "dependencies": {
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "^2.0.1",
    "@napi-rs/keyring": "^1.3.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
